{
  "name": "tax-calculator-electron",
  "version": "1.0.0",
  "main": "dist/src/main/main.js",
  "scripts": {
    "build": "node scripts/build.js",
    "start": "pnpm run build && electron .",
    "dev": "concurrently \"pnpm run watch\" \"electron .\"",
    "watch": "swc src -d dist --watch",
    "pack": "pnpm run build && electron-builder --dir",
    "dist": "pnpm run build && electron-builder",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "test": "jest",
    "type-check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.16.20",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "concurrently": "^9.2.5",
    "electron": "44.10.0",
    "electron-builder": "^26.18.1",
    "fs-extra": "^11.4.1",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "swc-loader": "^0.2.7",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "electron-store": "^10.1.0",
    "i18next": "^25.10.10",
    "i18next-node-fs-backend": "^2.1.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "build": {
    "appId": "com.shoppingmall.taxcalculator",
    "productName": "Shopping Mall Tax Calculator",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "@xlsx/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "allowElevation": true,
      "runAfterFinish": false
    }
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.22.1"
  }
}
